# Copy to .env and fill in. NEVER commit the .env.

# --- LiveKit ---
# The media server. Generate the pair with:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Session ---
# Signs the participant token the API hands out at the door.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Where things live ---
# In development, with infra/docker-compose.yml up, the defaults below already
# work. In production these point at your real hostnames, and PUBLIC_BASE_URL is
# what room links are built from.
LIVEKIT_URL=ws://127.0.0.1:7880
PUBLIC_BASE_URL=http://localhost:5173

# --- Rooms ---
# How long a room survives after it is created.
ROOM_TTL_HOURS=16
# Minutes with nobody inside before the room closes itself.
ROOM_EMPTY_MIN=5

# --- Redis ---
# Optional: this is already the default.
# REDIS_URL=redis://127.0.0.1:6379

# --- Production only ---
# Both must resolve to the server before deploying, or the reverse proxy cannot
# issue certificates. The app and the API share DOMAIN_APP — same origin, no CORS.
# DOMAIN_APP=app.yourdomain.com
# DOMAIN_LIVEKIT=livekit.yourdomain.com

# Where the built frontend lives. Absent in development, where Vite serves it;
# set inside the image, where the API serves both.
# WEB_ROOT=/app/web

# --- Interface language ---
# The frontend reads this at build time. Leave unset for English.
# VITE_LANG=pt-BR
